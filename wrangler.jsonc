// Cloudflare Workers settings. `npm run build` writes the site to _site/, and `npx wrangler deploy`
// serves it as static assets. Server code (a Q&A box, an agent) can be added later with a `main` script.
{
  "name": "drshubhamgupta-com",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./_site",
    // Unknown paths get the site's 404 page, with a 404 status.
    "not_found_handling": "404-page",
    // /writing and /writing/ both work; the slash version is the canonical one.
    "html_handling": "auto-trailing-slash"
  }
}

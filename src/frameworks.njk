---
layout: layouts/page.njk
permalink: /frameworks/
title: Frameworks
description: Frameworks I keep in mind when building data science models to improve the product experience.
---
{%- for item in collections.frameworks | sort(false, false, "data.order") %}
{%- set fw = item.data %}
<section class="framework" id="{{ item.page.fileSlug }}">
  <h2 class="fw-title">{{ fw.title }}</h2>
  {% include "partials/framework-summary.njk" %}
  {%- if item.url %}
  <p class="fw-more"><a href="{{ item.url }}">Read the detailed use cases &rarr;</a></p>
  {%- else %}
  <p class="fw-more fw-soon">I’ll add detailed use cases once I get some time to write them properly.</p>
  {%- endif %}
</section>
{%- endfor %}

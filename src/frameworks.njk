---
layout: layouts/page.njk
permalink: /frameworks/
title: Frameworks
description: Frameworks I use to think about products and growth.
---
{%- for item in collections.frameworks | sort(false, false, "data.order") %}
{%- set fw = item.data %}
<section class="framework" id="{{ item.page.fileSlug }}">
  <h2 class="fw-title">{{ fw.title }}</h2>
  {% include "partials/framework-summary.njk" %}
  {%- if item.url %}
  <p class="fw-more"><a href="{{ item.url }}">Read the full post &rarr;</a></p>
  {%- else %}
  <p class="fw-more fw-soon">Detailed post coming soon.</p>
  {%- endif %}
</section>
{%- endfor %}
